# Maintainer: Fergal Moran <aur@ferg.al>
pkgname=tvnoms-proxy
pkgver=1.3.0
pkgrel=1
pkgdesc="Tvnoms Proxy Service - IPTV/Streaming Proxy Server"
arch=('x86_64')
url="https://github.com/tvnoms/tvnoms-proxy"
license=('custom')
depends=('glibc' 'gcc-libs' 'zlib' 'openssl')
optdepends=('sqlite: Database backend')
provides=('tvnoms-proxy')
conflicts=('tvnoms-proxy')
options=('!debug' '!strip')
backup=('opt/tvnoms-proxy/appsettings.json')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/tvnoms/tvnoms-proxy/releases/download/v${pkgver}/tvnoms-proxy-linux.tar.gz")
sha256sums=('2ae4212e3c93b71678bf794c0aaeafd4d10bdc1249d5221fa6fb0dcf03277b44')

package() {
    cd "$srcdir"

    # Create installation directory
    install -dm755 "$pkgdir/opt/tvnoms-proxy"
    
    # Copy all files from the published output
    cp -r * "$pkgdir/opt/tvnoms-proxy/"
    
    # Ensure the main executable has proper permissions
    chmod 755 "$pkgdir/opt/tvnoms-proxy/tvnoms-proxy"
    
    # Install user systemd service file if present
    if [ -f "tvnoms-proxy-user.service" ]; then
        install -Dm644 tvnoms-proxy-user.service "$pkgdir/usr/lib/systemd/user/tvnoms-proxy.service"
    fi
    
    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
    fi
    
    # Remove installer scripts from the installation directory
    rm -f "$pkgdir/opt/tvnoms-proxy/install.sh"
    rm -f "$pkgdir/opt/tvnoms-proxy/uninstall.sh"
    rm -f "$pkgdir/opt/tvnoms-proxy/tvnoms-proxy.service"
    rm -f "$pkgdir/opt/tvnoms-proxy/tvnoms-proxy-user.service"
}

post_install() {
    echo ""
    echo "==> Tvnoms Proxy has been installed!"
    echo ""
    echo "Setting permissions..."
    chown -R $USER:$USER /opt/tvnoms-proxy
    
    echo ""
    echo "To start the service:"
    echo "  systemctl --user enable --now tvnoms-proxy"
    echo ""
    echo "Configuration file: /opt/tvnoms-proxy/appsettings.json"
    echo ""
    echo "View logs:"
    echo "  journalctl --user -u tvnoms-proxy -f"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> Upgrading tvnoms-proxy..."
    
    # Check if service is running
    if systemctl --user is-active --quiet tvnoms-proxy 2>/dev/null; then
        echo "Stopping service..."
        systemctl --user stop tvnoms-proxy
        SERVICE_WAS_RUNNING=1
    fi
    
    echo "Setting permissions..."
    chown -R $USER:$USER /opt/tvnoms-proxy
    
    echo "Reloading systemd daemon..."
    systemctl --user daemon-reload
    
    # Restart service if it was running
    if [ -n "$SERVICE_WAS_RUNNING" ]; then
        echo "Restarting service..."
        systemctl --user start tvnoms-proxy
    fi
    
    echo ""
    echo "==> Tvnoms Proxy has been upgraded!"
    echo ""
    if [ -z "$SERVICE_WAS_RUNNING" ]; then
        echo "If you want to start the service, run:"
        echo "  systemctl --user restart tvnoms-proxy"
        echo ""
    fi
}

pre_remove() {
    echo "Stopping and disabling service..."
    
    if systemctl --user is-active --quiet tvnoms-proxy 2>/dev/null; then
        systemctl --user stop tvnoms-proxy
    fi
    
    if systemctl --user is-enabled --quiet tvnoms-proxy 2>/dev/null; then
        systemctl --user disable tvnoms-proxy
    fi
}

post_remove() {
    systemctl --user daemon-reload 2>/dev/null || true
    
    echo ""
    echo "==> Tvnoms Proxy has been removed."
    echo ""
    echo "Data and logs remain in:"
    echo "  /opt/tvnoms-proxy/Data"
    echo "  /opt/tvnoms-proxy/logs"
    echo ""
    echo "Remove these manually if desired."
    echo ""
}
