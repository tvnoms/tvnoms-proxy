<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tvnoms.Proxy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.4.58</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>../scripts/packaging/branding/app-icon.ico</ApplicationIcon>
    <Product>Tvnoms Proxy</Product>
    <Company>Tvnoms</Company>
    <Copyright>Copyright © Tvnoms 2025</Copyright>
    <Description>Tvnoms Proxy Service</Description>
  </PropertyGroup>

  <!-- Define WINDOWS constant when building/publishing for Windows -->
  <PropertyGroup Condition="$(RuntimeIdentifier.Contains('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <!-- Also define WINDOWS when OS is Windows and no specific RID is set -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' AND '$(RuntimeIdentifier)' == ''">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- RecordVm and its validator are internal; the tests exercise them directly. -->
    <InternalsVisibleTo Include="tvnoms-proxy.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CrystalQuartz.AspNetCore" Version="7.3.0" />
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <!-- Only SQLite is used. The FluentMigrator.Runner meta-package pulls in a runner (and driver)
         for every supported database — DB2, Oracle, SQL Server, etc. — so reference just the pieces needed. -->
    <PackageReference Include="FluentMigrator.Runner.Core" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" />
    <PackageReference Include="Quartz" Version="4.1.0" />
    <PackageReference Include="Quartz.AspNetCore" Version="4.1.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.1.0" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="4.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\tvnoms.sql" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <None Include=".krud\.gitignore" />
    <None Include=".krud\.SRCINFO" />
    <None Include=".krud\PKGBUILD" />
    <None Include=".krud\update-sha.sh" />
    <None Include=".krud\tvnoms-proxy-1.3.0.tar.gz" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Compile Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="logs\**" />
    <Content Remove="publish\**" />
    <Content Include=".github\workflows\build-installers.yaml" />
  </ItemGroup>

  <!-- Simplified: Exclude entire publish and logs directories -->
  <ItemGroup>
    <Content Remove="publish/**" />
    <Compile Remove="publish/**" />
    <EmbeddedResource Remove="publish/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="tests/**" />
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- tvnoms-tray is its own project living in a subfolder of this repo — excluded from this
       project's own default globs the same way tests/** is above. -->
  <ItemGroup>
    <Content Remove="tvnoms-tray/**" />
    <Compile Remove="tvnoms-tray/**" />
    <EmbeddedResource Remove="tvnoms-tray/**" />
    <None Remove="tvnoms-tray/**" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="pkg\tvnoms-proxy\opt\tvnoms-proxy\appsettings.json" />
    <_ContentIncludedByDefault Remove="pkg\tvnoms-proxy\opt\tvnoms-proxy\global.json" />
    <_ContentIncludedByDefault Remove="pkg\tvnoms-proxy\opt\tvnoms-proxy\tvnoms-proxy.staticwebassets.endpoints.json" />
    <_ContentIncludedByDefault Remove="src\appsettings.json" />
    <_ContentIncludedByDefault Remove="src\global.json" />
    <_ContentIncludedByDefault Remove="src\tvnoms-proxy.staticwebassets.endpoints.json" />
  </ItemGroup>

</Project>
