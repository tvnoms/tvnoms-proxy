<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tvnoms.Tray.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <!-- Starts hidden: App.axaml.cs shows it on Windows/macOS, while on Linux it stays hidden
           and Services/Linux/LinuxTrayIcon publishes its icon, tooltip and menu over D-Bus. -->
      <TrayIcon IsVisible="False"
                Icon="{Binding IconSource}"
                ToolTipText="{Binding TooltipText}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open web UI"
                            Command="{Binding OpenWebUiCommand}"
                            IsEnabled="{Binding IsWebUiEnabled}" />
            <NativeMenuItem Header="Set web UI URL…"
                            Command="{Binding OpenSettingsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Start service"
                            Command="{Binding StartProxyCommand}"
                            IsEnabled="{Binding CanStartProxy}" />
            <NativeMenuItem Header="Stop service"
                            Command="{Binding StopProxyCommand}"
                            IsEnabled="{Binding CanStopProxy}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit"
                            Command="{Binding QuitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
